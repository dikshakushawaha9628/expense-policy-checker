# Copy to .env (never commit .env). All values optional - defaults shown.

# SQLite file location
EXPENSE_DB_PATH=output/expenses.db

# AI provider: "heuristic" (offline, default) | "ollama" (local model) | "none"
AI_PROVIDER=heuristic

# Only used when AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_TIMEOUT_SECONDS=30

# Observations below this confidence are flagged for human review
AI_MIN_CONFIDENCE=0.6
